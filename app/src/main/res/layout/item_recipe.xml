<?xml version="1.0" encoding="utf-8"?>
<android.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp" app:cardElevation="4dp">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="warp_content"
        android:orientation="vertical" android:padding="12dp">

        <TextView android:id="@+id/txtRecipeName"
            android:layout_width="match_parent"
            android:layout_heigt="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"/>
        <TextView android:id="@+id/txtRecipeIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"/>
        <TextView android:id="@+id/txtInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>